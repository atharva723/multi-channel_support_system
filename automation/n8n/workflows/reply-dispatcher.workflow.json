{
  "name": "Omnichannel Sentinel — Reply Dispatcher",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-reply",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000001",
      "name": "Send-Reply Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-480, 0],
      "webhookId": "send-reply"
    },
    {
      "parameters": {
        "jsCode": "// The FastAPI backend POSTs this shape when an agent approves/edits a reply:\n// { ticket_id, channel, channel_id, author_name, author_contact, reply_text }\nconst b = $json.body ?? $json;\nreturn [{ json: {\n  ticket_id: b.ticket_id ?? null,\n  channel: String(b.channel ?? '').toLowerCase(),\n  channel_id: String(b.channel_id ?? ''),\n  author_name: String(b.author_name ?? ''),\n  author_contact: String(b.author_contact ?? ''),\n  reply_text: String(b.reply_text ?? '')\n}}];"
      },
      "id": "aa000000-0000-4000-8000-000000000002",
      "name": "Normalize Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-260, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "discord",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "discord"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "slack",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "slack"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.channel }}",
                    "rightValue": "email",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "email"
            }
          ]
        },
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000003",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "content": "={{ $json.reply_text }}",
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000004",
      "name": "Send Discord Reply",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [220, -160],
      "credentials": {
        "discordBotApi": {
          "id": "REPLACE_DISCORD_CREDENTIAL_ID",
          "name": "Discord Bot account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": "={{ $json.channel_id }}",
        "text": "={{ $json.reply_text }}",
        "otherOptions": {}
      },
      "id": "aa000000-0000-4000-8000-000000000005",
      "name": "Send Slack Reply",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [220, 0],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "support@yourdomain.com",
        "toEmail": "={{ $json.author_contact }}",
        "subject": "Re: your support request",
        "emailFormat": "text",
        "text": "={{ $json.reply_text }}",
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000006",
      "name": "Send Email Reply",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [220, 160],
      "credentials": {
        "smtp": {
          "id": "REPLACE_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Send-Reply Webhook": {
      "main": [[{ "node": "Normalize Reply", "type": "main", "index": 0 }]]
    },
    "Normalize Reply": {
      "main": [[{ "node": "Route by Channel", "type": "main", "index": 0 }]]
    },
    "Route by Channel": {
      "main": [
        [{ "node": "Send Discord Reply", "type": "main", "index": 0 }],
        [{ "node": "Send Slack Reply", "type": "main", "index": 0 }],
        [{ "node": "Send Email Reply", "type": "main", "index": 0 }]
      ]
    }
  }
}
