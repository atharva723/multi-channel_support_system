        "toEmail": "={{ $json.ticket.author_name }}",
        "subject": "Re: your support request",
        "emailFormat": "text",
        "text": "={{ $json.ticket.ai_draft_reply }}",
        "options": {}
      },
      "id": "f3333333-3333-4333-8333-333333333333",
