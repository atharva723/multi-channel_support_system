{
  "name": "Omnichannel Sentinel — Triage Router",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "discord-ingest",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Discord Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-560, -200],
      "webhookId": "discord-ingest"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-ingest",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "Slack Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-560, 0],
      "webhookId": "slack-ingest"
    },
    {
      "parameters": {
        "postProcessAction": "read",
        "options": {}
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "IMAP Email Trigger",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [-560, 200],
      "credentials": {
        "imap": {
          "id": "REPLACE_IMAP_CREDENTIAL_ID",
          "name": "IMAP account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Normalize a raw Discord message into the Sentinel ingest payload.\nconst b = $json.body ?? $json;\nreturn [{ json: {\n  channel: 'discord',\n  channel_id: String(b.channel_id ?? b.channelId ?? ''),\n  message_id: String(b.id ?? b.message_id ?? ''),\n  author_name: String(b.author?.username ?? b.author_name ?? 'Unknown'),\n  author_contact: String(b.author?.id ?? b.author_contact ?? ''),\n  content: String(b.content ?? b.text ?? '')\n}}];"
      },
      "id": "b1111111-1111-4111-8111-111111111111",
      "name": "Normalize Discord",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, -200]
    },
    {
      "parameters": {
        "jsCode": "// Normalize a Slack Events API payload into the Sentinel ingest payload.\nconst b = $json.body ?? $json;\nconst e = b.event ?? b;\nreturn [{ json: {\n  channel: 'slack',\n  channel_id: String(e.channel ?? ''),\n  message_id: String(e.client_msg_id ?? e.ts ?? ''),\n  author_name: String(e.user ?? 'Unknown'),\n  author_contact: String(e.user ?? ''),\n  content: String(e.text ?? '')\n}}];"
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Normalize Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "jsCode": "// Normalize an IMAP email (parsed) into the Sentinel ingest payload.\nconst b = $json;\nconst from0 = b.from?.value?.[0] ?? {};\nreturn [{ json: {\n  channel: 'email',\n  channel_id: String(b.mailboxPath ?? 'INBOX'),\n  message_id: String(b.messageId ?? b.id ?? ''),\n  author_name: String(from0.name ?? b.from?.text ?? 'Unknown'),\n  author_contact: String(from0.address ?? b.from?.text ?? ''),\n  content: String(b.textPlain ?? b.text ?? b.textHtml ?? '')\n}}];"
      },
      "id": "b3333333-3333-4333-8333-333333333333",
      "name": "Normalize Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/support/triage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.SENTINEL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.channel, channel_id: $json.channel_id, message_id: $json.message_id, author_name: $json.author_name, author_contact: $json.author_contact, content: $json.content }) }}",
        "options": {}
      },
      "id": "c1111111-1111-4111-8111-111111111111",
      "name": "Post to FastAPI Triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-critical",
              "leftValue": "={{ $json.is_critical }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1111111-1111-4111-8111-111111111111",
      "name": "Is Critical?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [160, 0]
    },
    {
      "parameters": {},
      "id": "e1111111-1111-4111-8111-111111111111",
      "name": "Escalated (SSE handled by backend)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [400, -160]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ticket.channel }}",
                    "rightValue": "discord",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "discord"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ticket.channel }}",
                    "rightValue": "slack",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "slack"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ticket.channel }}",
                    "rightValue": "email",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "email"
            }
          ]
        },
        "options": {}
      },
      "id": "d2222222-2222-4222-8222-222222222222",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [400, 120]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "content": "={{ $json.ticket.ai_draft_reply }}",
        "options": {}
      },
      "id": "f1111111-1111-4111-8111-111111111111",
      "name": "Reply on Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [660, 0],
      "credentials": {
        "discordBotApi": {
