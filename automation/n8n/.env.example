# n8n local configuration (Omnichannel AI Support Sentinel)
# All n8n data (SQLite DB, encryption key) is stored in this project's .n8n folder
# so the project is self-contained and easy to back up.
N8N_USER_FOLDER=./.n8n

# Editor URL / port
N8N_PORT=5678
N8N_HOST=localhost

# Timezone used by schedule/cron nodes
GENERIC_TIMEZONE=Asia/Kolkata

# Allow the Code node to run JS without extra warnings
N8N_RUNNERS_ENABLED=true

# Shared secret the FastAPI backend sends as X-API-Key on /triage (optional).
# Must match SENTINEL_API_KEY on the backend if you enable it there.
SENTINEL_API_KEY=
