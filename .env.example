# Omnichannel AI Support Sentinel — environment configuration
# Copy to `.env` inside `backend/` and fill in real values. All secrets live
# server-side (FastAPI); the mobile client never sees platform tokens.
#
# Settings are read by pydantic-settings with the SENTINEL_ prefix.

# --- Core ---
SENTINEL_DEBUG=false

# --- Database (SQLite, async) ---
SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# --- LLM Router (Ollama) ---
SENTINEL_OLLAMA_HOST=http://localhost:11434
SENTINEL_OLLAMA_MODEL=llama3.2
SENTINEL_OLLAMA_TIMEOUT=60

# --- Triage ---
SENTINEL_CRITICALITY_THRESHOLD=0.8

# --- Auth / sessions (JWT) ---
# App session tokens carry the account_id. CHANGE the secret in production.
SENTINEL_JWT_SECRET=dev-insecure-change-me
SENTINEL_JWT_EXPIRES_MINUTES=20160

# --- Token encryption at rest (Fernet) ---
# Encrypts provider OAuth tokens in the DB. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If blank, a key is derived from JWT_SECRET (dev only).
SENTINEL_TOKEN_ENCRYPTION_KEY=

# --- Public base URL (used to build OAuth redirect URIs) ---
SENTINEL_APP_BASE_URL=http://localhost:8000
# Where to send the user after a successful OAuth connect (mobile deep link).
SENTINEL_OAUTH_SUCCESS_REDIRECT=sentinel://auth/success

# --- OAuth providers (identity + send authorization; per-account, multi-tenant) ---
# Each connection is BOTH how a user signs in and the token used to send replies.
# Register an OAuth app with each provider and paste client id/secret here.
SENTINEL_GOOGLE_CLIENT_ID=
SENTINEL_GOOGLE_CLIENT_SECRET=
SENTINEL_DISCORD_CLIENT_ID=
SENTINEL_DISCORD_CLIENT_SECRET=
# Discord bot token used for sending channel messages (the bot must be in the guild).
SENTINEL_DISCORD_BOT_TOKEN=

# --- SLA urgency decay constants (lambda_c) ---
SENTINEL_LAMBDA_DISCORD=0.05
SENTINEL_LAMBDA_EMAIL=0.01
